#!/bin/sh
set -e

case "$1" in
    configure)
        # Stop and disable PVS — it must not run until the user has configured it.
        # The firewall kill-switch is intentionally left in place to prevent
        # unprotected traffic reaching the internet without an active VPN.
        systemctl stop pvs.service 2>/dev/null || true
        systemctl disable pvs.service 2>/dev/null || true

        cat <<'INSTRUCTIONS'

================================================================================
  PVS (Pearson VPN Service) — Post-Install Setup
================================================================================

  PVS has been stopped and disabled. It will NOT start until you
  complete the setup below and start it manually.

  1. ADD VPN CONFIGS

     Place your .ovpn config files in one of:

       /usr/bin/pvs/protonvpn/vpn_configs/
       /usr/bin/pvs/expressvpn/vpn_configs/

  2. SET VPN CREDENTIALS

     Edit the credentials file (username on line 1, password on line 2):

       sudo vi /config/openvpn-credentials.txt

     Ensure permissions are restricted:

       sudo chmod 600 /config/openvpn-credentials.txt

  3. EDIT CONFIGURATION

       sudo vi /usr/bin/pvs/config.yml

     Key settings:
       - openvpn.config_dir     Path to your .ovpn directory
       - openvpn.preferred_configs  List of preferred .ovpn filenames
       - firewall.enabled       Set false if single-interface (avoids lockout!)
       - firewall.privateNetworkSubnet     Your LAN subnet
       - firewall.privateNetworkInterface  Your LAN interface name

  4. ENABLE AND START

       sudo systemctl daemon-reload
       sudo systemctl enable pvs.service
       sudo systemctl start pvs.service

  5. VERIFY

       sudo systemctl status pvs.service
       tail -f /var/log/pvs.log

  Documentation: /usr/share/doc/pvs/README

================================================================================

INSTRUCTIONS
        ;;
esac

exit 0
